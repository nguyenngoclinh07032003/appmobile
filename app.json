{
  "expo": {
    "name": "Thợ Minh Đức",
    "slug": "tho-minh-duc-app",
    "version": "3.0.8",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "ios": {
      "icon": "./assets/app-icon.png",
      "bundleIdentifier": "com.hrmss.thominhduc",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Thợ Minh Đức dùng vị trí để xác nhận đến nơi tại nhà khách và chia sẻ vị trí khi thợ đang di chuyển đến nơi."
      }
    },
    "android": {
      "package": "com.hrmss.thominhduc",
      "versionCode": 2,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      }
    },
    "userInterfaceStyle": "light",
    "web": {
      "name": "Thợ Minh Đức",
      "shortName": "Thợ Minh Đức",
      "lang": "vi",
      "display": "standalone",
      "startUrl": "/",
      "backgroundColor": "#f4f7fb",
      "themeColor": "#0b4da2",
      "favicon": "./assets/app-icon.png"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Thợ Minh Đức cần truy cập thư viện ảnh để bạn đính kèm ảnh thiết bị, ảnh minh chứng và biên lai.",
          "cameraPermission": "Thợ Minh Đức cần dùng máy ảnh để chụp ảnh thiết bị, ảnh minh chứng và biên lai."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Thợ Minh Đức dùng vị trí để xác nhận đến nơi tại nhà khách và chia sẻ vị trí khi thợ đang di chuyển đến nơi.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1c388b83-88a9-4f55-bb10-8822d4201e4b"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/1c388b83-88a9-4f55-bb10-8822d4201e4b"
    }
  }
}
