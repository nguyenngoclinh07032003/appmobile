{
  "expo": {
    "name": "Thợ Minh Đức",
    "slug": "tho-minh-duc-app",
    "version": "3.0.8",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "ios": {
      "icon": "./assets/app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      }
    },
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "HRMSS cần truy cập thư viện ảnh để bạn đính kèm ảnh thiết bị, ảnh minh chứng và biên lai.",
          "cameraPermission": "HRMSS cần dùng camera để chụp ảnh thiết bị, ảnh minh chứng và biên lai."
        }
      ]
    ]
  }
}
