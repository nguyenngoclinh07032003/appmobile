# Cấu hình server cho app HRMSS (copy thành .env.local rồi sửa; .env.local không đưa lên git).
# Không đặt EXPO_PUBLIC_API_URL -> app gọi server thật https://server.hrmss.cyou/api/v1.
# Thử / demo với backend chạy trên máy (Expo web hoặc giả lập trên cùng máy):
# EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1
# Điện thoại thật trong cùng mạng LAN: dùng IP máy chạy backend, ví dụ
# EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api/v1
# Đổi xong chạy lại: npx expo start -c
