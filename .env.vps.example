# Cấu hình chạy Docker trên VPS.
# Trên VPS: cp .env.vps.example .env  rồi sửa giá trị, sau đó: docker compose up -d --build
# (.env không đưa lên git)

# Tên network Docker mà Caddy (folder infra) đang dùng. Xem bằng: docker network ls
INFRA_NETWORK=web

# URL backend nhúng vào bản web lúc build.
# Để trống -> dùng server thật https://server.hrmss.cyou/api/v1
# Đổi giá trị này phải build lại: docker compose up -d --build
EXPO_PUBLIC_API_URL=

